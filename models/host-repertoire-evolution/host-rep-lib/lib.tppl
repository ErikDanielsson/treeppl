import "lib.mc"

// NOTE(ErikDanielsson, 04-09-2025) Constructs an Kronecker delta of a given length
function kroneckerDelta(index : Int, length : Int) => Real[] {
  return seqKroneckerDelta(index)(length);
}

function isNaN(r : Real) => Bool {
  return mathIsNaN(r);
}

// NOTE(ErikDanielsson, 22-01-2026): Constructs a matrix from a nested list.
// Does not verify non-jaggedness and requires the outer list to be nonempty
function nestSeqToMtx(ns : Real[][]) => Matrix[Real] {
  let n = length(ns); 
  let m = length(ns[1]);
  return mtxCreate(n, m, paste0(ns));
}